    s = s & "' (sayı kutusu + yukarı/aşağı okları, açılır liste, onay kutusu)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Public WithEvents tb As MSForms.TextBox" & vbCrLf
    s = s & "Public WithEvents sp As MSForms.SpinButton" & vbCrLf
    s = s & "Public WithEvents cb As MSForms.ComboBox" & vbCrLf
    s = s & "Public WithEvents ch As MSForms.CheckBox" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Public Frm As Object" & vbCrLf
    s = s & "Public Tamsayi As Boolean" & vbCrLf
    s = s & "Public MinDeger As Double" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub sp_SpinUp()" & vbCrLf
    s = s & "    Adim 1" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub sp_SpinDown()" & vbCrLf
    s = s & "    Adim -1" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub Adim(ByVal yon As Long)" & vbCrLf
    s = s & "    Dim v As Double, st As Double" & vbCrLf
    s = s & "    v = Frm.SayiOku(tb.Text)" & vbCrLf
    s = s & "    If Tamsayi Then" & vbCrLf
    s = s & "        st = 1" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        st = Frm.AdimBuyuklugu()" & vbCrLf
