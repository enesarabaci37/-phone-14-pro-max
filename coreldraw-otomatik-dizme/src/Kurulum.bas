Attribute VB_Name = "AtolyeKurulum"
Option Explicit

'=====================================================================
'  ATÖLYE ARAÇLARI - KURULUM
'  Bu modülü BOŞ bir belgenin projesine (VBAProject (İsimsiz-1)) ekleyin,
'  imleci "Kur" içine koyup F5'e basın. Araçlar GlobalMacros'a kurulur.
'  Kurulumdan sonra boş belgeyi kaydetmeden kapatabilirsiniz.
'=====================================================================

Private Const PROJE As String = "GlobalMacros"
Private rapor As String
Private hataVar As Boolean

Public Sub Kur()
    Dim vbeObj As Object, prj As Object, p As Object, kaydet As Object

    rapor = ""
    hataVar = False
    On Error Resume Next

    Set vbeObj = Application.VBE
    If vbeObj Is Nothing Then
        MsgBox "VBA düzenleyicisine erişilemedi: " & Err.Description, vbExclamation, "Atölye Araçları - Kurulum"
        Exit Sub
    End If
    For Each p In vbeObj.VBProjects
        If LCase$(p.Name) = LCase$(PROJE) Then Set prj = p
    Next p
    If prj Is Nothing Then
        MsgBox "'" & PROJE & "' projesi bulunamadı.", vbExclamation, "Atölye Araçları - Kurulum"
        Exit Sub
    End If

    BilesenKur prj, "clsOlay", 2, K_clsOlay_1()
    BilesenKur prj, "modAtolye", 1, K_modAtolye_1() & K_modAtolye_2()
    BilesenKur prj, "frmDizme", 3, K_frmDizme_1() & K_frmDizme_2() & K_frmDizme_3()
    BaslangicKur prj, K_baslangic_1()

    ' Kaydet
    Err.Clear
    Set vbeObj.ActiveVBProject = prj
    Set kaydet = vbeObj.CommandBars.FindControl(Id:=3)
    If Not kaydet Is Nothing Then kaydet.Execute
    If Err.Number <> 0 Then
        rapor = rapor & "• GlobalMacros otomatik kaydedilemedi; CorelDRAW kapanırken 'Evet' deyin." & vbCrLf
        Err.Clear
    Else
        rapor = rapor & "• GlobalMacros kaydedildi." & vbCrLf
    End If

    ' Araç çubuğu
    If Not hataVar Then
        Err.Clear
        Application.GMSManager.RunMacro PROJE, "modAtolye.AracCubuguOtomatik"
        If Err.Number <> 0 Then
            rapor = rapor & "• Araç çubuğu otomatik eklenemedi (" & Err.Description & ")." & vbCrLf & _
                    "  Araçlar > Betikler > Betikler > GlobalMacros > modAtolye > AracCubuguKur ile ekleyin." & vbCrLf
            Err.Clear
        Else
            rapor = rapor & "• 'Atölye Araçları' araç çubuğu eklendi." & vbCrLf
        End If
    End If

    If hataVar Then
        MsgBox "Kurulum tamamlanamadı:" & vbCrLf & vbCrLf & rapor, vbExclamation, "Atölye Araçları - Kurulum"
    Else
        MsgBox "Kurulum tamamlandı." & vbCrLf & vbCrLf & rapor & vbCrLf & _
               "Bu boş belgeyi KAYDETMEDEN kapatabilirsiniz." & vbCrLf & _
               "Kullanım: nesneleri seçin, üst bardaki logolu düğmeye basın.", _
               vbInformation, "Atölye Araçları - Kurulum"
    End If
End Sub

Private Sub BilesenKur(prj As Object, ByVal adi As String, ByVal tur As Long, ByVal kod As String)
    Dim c As Object, cm As Object
    On Error Resume Next
    Set c = prj.VBComponents.Item(adi)
    Err.Clear
    If c Is Nothing Then
        Set c = prj.VBComponents.Add(tur)
        If Err.Number <> 0 Or c Is Nothing Then
            rapor = rapor & "• " & adi & " eklenemedi (" & Err.Description & ")." & vbCrLf
            hataVar = True
            Exit Sub
        End If
        c.Name = adi
        If Err.Number <> 0 Then
            rapor = rapor & "• " & adi & " adı verilemedi (" & Err.Description & ")." & vbCrLf & _
                    "  CorelDRAW'u kapatıp açın ve kurulumu tekrar çalıştırın." & vbCrLf
            Err.Clear
            prj.VBComponents.Remove c
            hataVar = True
            Exit Sub
        End If
    End If
    Set cm = c.CodeModule
    If cm.CountOfLines > 0 Then cm.DeleteLines 1, cm.CountOfLines
    cm.AddFromString kod
    If Err.Number <> 0 Then
        rapor = rapor & "• " & adi & " kodu yazılamadı (" & Err.Description & ")." & vbCrLf
        hataVar = True
        Err.Clear
    Else
        rapor = rapor & "• " & adi & " kuruldu." & vbCrLf
    End If
End Sub

Private Sub BaslangicKur(prj As Object, ByVal kod As String)
    Dim c As Object, cm As Object, mevcut As String
    On Error Resume Next
    Set c = prj.VBComponents.Item("ThisMacroStorage")
    If c Is Nothing Then
        rapor = rapor & "• Otomatik başlatma eklenemedi (ThisMacroStorage yok)." & vbCrLf
        Exit Sub
    End If
    Set cm = c.CodeModule
    If cm.CountOfLines > 0 Then mevcut = cm.Lines(1, cm.CountOfLines)
    If InStr(1, mevcut, "AracCubuguOtomatik", vbTextCompare) > 0 Then
        rapor = rapor & "• Otomatik başlatma zaten var." & vbCrLf
        Exit Sub
    End If
    If InStr(1, mevcut, "GlobalMacroStorage_Start", vbTextCompare) > 0 Then
        rapor = rapor & "• ThisMacroStorage'da başka bir başlangıç kodu var; otomatik başlatma eklenmedi." & vbCrLf
        Exit Sub
    End If
    cm.AddFromString kod
    If Err.Number <> 0 Then
        rapor = rapor & "• Otomatik başlatma eklenemedi (" & Err.Description & ")." & vbCrLf
        Err.Clear
    Else
        rapor = rapor & "• CorelDRAW açılışında araç çubuğu otomatik gelecek." & vbCrLf
    End If
End Sub

