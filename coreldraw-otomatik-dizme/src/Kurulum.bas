    s = s & "    m = SecimDiziyeAl(sr)" & vbCrLf
    s = s & "    If m = 0 Then" & vbCrLf
    s = s & "        hesapMesaj = ""Başlamak için dizilecek nesneleri CorelDRAW'da seçin"" & vbCrLf & _" & vbCrLf
    s = s & "                     ""ve 'Yenile' düğmesine basın."" & vbCrLf & vbCrLf & _" & vbCrLf
    s = s & "                     ""Bu pencere açıkken de seçim yapabilirsiniz.""" & vbCrLf
    s = s & "        Exit Sub" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' --- Parametreler (mm)" & vbCrLf
    s = s & "    adim = ""ayarlar""" & vbCrLf
    s = s & "    If chkSayfa.Value Then" & vbCrLf
    s = s & "        If Not SayfaBoyutu(matW, matH) Then hesapMesaj = ""Sayfa boyutu okunamadı."": Exit Sub" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        matW = SayiOku(txtGen.Text) * birimCarpan" & vbCrLf
    s = s & "        matH = SayiOku(txtYuk.Text) * birimCarpan" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    pKenar = SayiOku(txtKenar.Text) * birimCarpan" & vbCrLf
    s = s & "    pGap = SayiOku(txtBosluk.Text) * birimCarpan" & vbCrLf
    s = s & "    adet = CLng(SayiOku(txtAdet.Text))" & vbCrLf
    s = s & "    allowRot = (cmbDondur.ListIndex = 1)" & vbCrLf
    s = s & "    kalite = cmbKalite.ListIndex" & vbCrLf
    s = s & "    pBasla = cmbBasla.ListIndex" & vbCrLf
    s = s & "    pKontur = CBool(chkKontur.Value)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    If matW <= 0 Or matH <= 0 Then hesapMesaj = ""Malzeme genişliği ve yüksekliği 0'dan büyük olmalı."": Exit Sub" & vbCrLf
    s = s & "    If pKenar < 0 Or pGap < 0 Then hesapMesaj = ""Boşluk ve kenar payı negatif olamaz."": Exit Sub" & vbCrLf
    s = s & "    If adet < 1 Then hesapMesaj = ""Adet en az 1 olmalı."": Exit Sub" & vbCrLf
    s = s & "    usW = matW - 2 * pKenar" & vbCrLf
    s = s & "    usH = matH - 2 * pKenar" & vbCrLf
    s = s & "    If usW <= 0 Or usH <= 0 Then hesapMesaj = ""Kenar payı malzemeye göre çok büyük."": Exit Sub" & vbCrLf
    s = s & "    If m * adet > 5000 Then hesapMesaj = ""En fazla 5000 nesne dizilebilir (şu an "" & m * adet & "")."": Exit Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' --- Nesne ölçüleri" & vbCrLf
    s = s & "    ReDim w0(1 To m): ReDim h0(1 To m)" & vbCrLf
    s = s & "    eskiBirim = doc.Unit" & vbCrLf
    s = s & "    doc.Unit = cdrMillimeter" & vbCrLf
    s = s & "    For i = 1 To m" & vbCrLf
    s = s & "        adim = ""nesne ölçüleri "" & i & ""/"" & m" & vbCrLf
    s = s & "        Set sh = secS(i)" & vbCrLf
    s = s & "        sh.GetBoundingBox bx, byy, bw, bh, pKontur" & vbCrLf
    s = s & "        w0(i) = bw: h0(i) = bh" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    doc.Unit = eskiBirim" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    adim = ""ayarlar""" & vbCrLf
    s = s & "    For i = 1 To m" & vbCrLf
    s = s & "        If Not ((w0(i) <= usW + EPS And h0(i) <= usH + EPS) Or _" & vbCrLf
    s = s & "                (allowRot And h0(i) <= usW + EPS And w0(i) <= usH + EPS)) Then" & vbCrLf
    s = s & "            hesapMesaj = ""Bir nesne malzemeye sığmıyor:"" & vbCrLf & _" & vbCrLf
    s = s & "                         OlcuYazi(w0(i)) & "" x "" & OlcuYazi(h0(i)) & "" "" & BirimAdi() & vbCrLf & _" & vbCrLf
    s = s & "                         ""Kullanılabilir alan: "" & OlcuYazi(usW) & "" x "" & OlcuYazi(usH) & "" "" & BirimAdi() & _" & vbCrLf
    s = s & "                         IIf(allowRot, """", vbCrLf & ""(Döndürmeye izin vermeyi deneyin.)"")" & vbCrLf
    s = s & "            Exit Sub" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' --- Parça listesi" & vbCrLf
    s = s & "    n = m * adet" & vbCrLf
    s = s & "    ReDim iSrc(1 To n): ReDim iKop(1 To n): ReDim iW(1 To n): ReDim iH(1 To n)" & vbCrLf
    s = s & "    ReDim aw(1 To n): ReDim ah(1 To n)" & vbCrLf
    s = s & "    k = 0" & vbCrLf
    s = s & "    For i = 1 To m" & vbCrLf
    s = s & "        For c = 1 To adet" & vbCrLf
    s = s & "            k = k + 1" & vbCrLf
    s = s & "            iSrc(k) = i: iKop(k) = c" & vbCrLf
    s = s & "            iW(k) = w0(i): iH(k) = h0(i)" & vbCrLf
    s = s & "            aw(k) = w0(i) + pGap: ah(k) = h0(i) + pGap" & vbCrLf
    s = s & "        Next c" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    nItem = n" & vbCrLf
    s = s & "    pMatW = matW: pMatH = matH" & vbCrLf
    s = s & "    pSW = usW + pGap: pSH = usH + pGap" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    adim = ""yerleşim hesabı""" & vbCrLf
    s = s & "    lblBilgi.Caption = ""Hesaplanıyor...""" & vbCrLf
    s = s & "    DoEvents" & vbCrLf
    s = s & "    rSheets = EnIyiYerlesim(n, aw, ah, pSW, pSH, allowRot, kalite, ARAMA_SAYISI)" & vbCrLf
    s = s & "    If rSheets <= 0 Then" & vbCrLf
    s = s & "        hesapMesaj = ""Yerleşim bulunamadı.""" & vbCrLf
    s = s & "        Exit Sub" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' Zemin - orta için her plakadaki kaydırma" & vbCrLf
    s = s & "    ReDim ortaKay(1 To rSheets)" & vbCrLf
    s = s & "    For k = 1 To n" & vbCrLf
    s = s & "        If rR(k) Then" & vbCrLf
    s = s & "            sag = rX(k) + ah(k)" & vbCrLf
    s = s & "        Else" & vbCrLf
    s = s & "            sag = rX(k) + aw(k)" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "        If sag > ortaKay(rS(k)) Then ortaKay(rS(k)) = sag" & vbCrLf
    s = s & "    Next k" & vbCrLf
    s = s & "    For c = 1 To rSheets" & vbCrLf
    s = s & "        ortaKay(c) = (pSW - ortaKay(c)) / 2" & vbCrLf
    s = s & "        If ortaKay(c) < 0 Then ortaKay(c) = 0" & vbCrLf
    s = s & "    Next c" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    hesapOK = True" & vbCrLf
    s = s & "    Exit Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Hata:" & vbCrLf
    s = s & "    hesapMesaj = ""Hesaplama hatası ("" & adim & ""): "" & Err.Description & "" ["" & Err.Number & ""]""" & vbCrLf
    s = s & "    hesapOK = False" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "'=====================================================================" & vbCrLf
    s = s & "'  ÖNİZLEME ÇİZİMİ" & vbCrLf
    s = s & "'=====================================================================" & vbCrLf
    s = s & "Private Sub Ciz()" & vbCrLf
    s = s & "    Dim PW As Double, PH As Double, sc As Double, sx As Double, sy As Double" & vbCrLf
    s = s & "    Dim k As Long, c As Long, adet As Long" & vbCrLf
    s = s & "    Dim x As Double, y As Double, w As Double, h As Double, dolu As Double, topDolu As Double" & vbCrLf
    s = s & "    Dim lb As MSForms.Label" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    frOn.Controls.Clear" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    If Not hesapOK Then" & vbCrLf
    s = s & "        Set lb = frOn.Controls.Add(""Forms.Label.1"")" & vbCrLf
    s = s & "        With lb" & vbCrLf
    s = s & "            .Left = 30: .Top = 150: .Width = frOn.InsideWidth - 60: .Height = 110" & vbCrLf
    s = s & "            .Caption = hesapMesaj" & vbCrLf
    s = s & "            .TextAlign = fmTextAlignCenter" & vbCrLf
    s = s & "            .BackStyle = fmBackStyleTransparent" & vbCrLf
    s = s & "            .Font.Name = FONT_INCE" & vbCrLf
    s = s & "            .Font.Size = 10.5" & vbCrLf
    s = s & "            .ForeColor = RGB(110, 110, 110)" & vbCrLf
    s = s & "        End With" & vbCrLf
    s = s & "        lblPlaka.Caption = """"" & vbCrLf
    s = s & "        lblBilgi.Caption = """"" & vbCrLf
    s = s & "        btnOnceki.Enabled = False" & vbCrLf
    s = s & "        btnSonraki.Enabled = False" & vbCrLf
    s = s & "        Exit Sub" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    If gosterPlaka < 1 Then gosterPlaka = 1" & vbCrLf
    s = s & "    If gosterPlaka > rSheets Then gosterPlaka = rSheets" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    PW = frOn.InsideWidth" & vbCrLf
    s = s & "    PH = frOn.InsideHeight" & vbCrLf
    s = s & "    sc = Min2((PW - 30) / pMatW, (PH - 30) / pMatH)" & vbCrLf
    s = s & "    sx = (PW - pMatW * sc) / 2" & vbCrLf
    s = s & "    sy = (PH - pMatH * sc) / 2" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' Gölge" & vbCrLf
    s = s & "    Set lb = frOn.Controls.Add(""Forms.Label.1"")" & vbCrLf
    s = s & "    With lb" & vbCrLf
    s = s & "        .Left = sx + 3: .Top = sy + 3: .Width = Max2(pMatW * sc, 2): .Height = Max2(pMatH * sc, 2)" & vbCrLf
    s = s & "        .BackColor = RGB(212, 215, 219)" & vbCrLf
    s = s & "    End With" & vbCrLf
    s = s & "    ' Plaka" & vbCrLf
    s = s & "    Set lb = frOn.Controls.Add(""Forms.Label.1"")" & vbCrLf
    s = s & "    With lb" & vbCrLf
    s = s & "        .Left = sx: .Top = sy: .Width = Max2(pMatW * sc, 2): .Height = Max2(pMatH * sc, 2)" & vbCrLf
    s = s & "        .BackColor = RGB(255, 255, 255)" & vbCrLf
    s = s & "        .BorderStyle = fmBorderStyleSingle" & vbCrLf
    s = s & "        .BorderColor = RGB(220, 40, 40)" & vbCrLf
    s = s & "    End With" & vbCrLf
    s = s & "    ' Kenar payı" & vbCrLf
    s = s & "    If pKenar > 0 Then" & vbCrLf
    s = s & "        Set lb = frOn.Controls.Add(""Forms.Label.1"")" & vbCrLf
    s = s & "        With lb" & vbCrLf
    s = s & "            .Left = sx + pKenar * sc: .Top = sy + pKenar * sc" & vbCrLf
    s = s & "            .Width = Max2((pMatW - 2 * pKenar) * sc, 1): .Height = Max2((pMatH - 2 * pKenar) * sc, 1)" & vbCrLf
    s = s & "            .BackStyle = fmBackStyleTransparent" & vbCrLf
    s = s & "            .BorderStyle = fmBorderStyleSingle" & vbCrLf
    s = s & "            .BorderColor = RGB(215, 215, 215)" & vbCrLf
    s = s & "        End With" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' Nesneler" & vbCrLf
    s = s & "    For k = 1 To nItem" & vbCrLf
    s = s & "        topDolu = topDolu + iW(k) * iH(k)" & vbCrLf
    s = s & "        If rS(k) = gosterPlaka Then" & vbCrLf
    s = s & "            Konum k, x, y, w, h" & vbCrLf
    s = s & "            adet = adet + 1" & vbCrLf
    s = s & "            dolu = dolu + iW(k) * iH(k)" & vbCrLf
    s = s & "            If c < MAKS_ONIZLEME Then" & vbCrLf
    s = s & "                c = c + 1" & vbCrLf
    s = s & "                Set lb = frOn.Controls.Add(""Forms.Label.1"")" & vbCrLf
    s = s & "                With lb" & vbCrLf
    s = s & "                    .Left = sx + (pKenar + x) * sc" & vbCrLf
    s = s & "                    .Top = sy + (pMatH - pKenar - y - h) * sc" & vbCrLf
    s = s & "                    .Width = Max2(w * sc, 1)" & vbCrLf
    s = s & "                    .Height = Max2(h * sc, 1)" & vbCrLf
    s = s & "                    .BorderStyle = fmBorderStyleSingle" & vbCrLf
    s = s & "                    If rR(k) Then" & vbCrLf
    s = s & "                        .BackColor = RGB(214, 232, 160)" & vbCrLf
    s = s & "                        .BorderColor = RGB(120, 150, 30)" & vbCrLf
    s = s & "                    Else" & vbCrLf
    s = s & "                        .BackColor = RGB(178, 226, 220)" & vbCrLf
    s = s & "                        .BorderColor = RGB(20, 150, 135)" & vbCrLf
    s = s & "                    End If" & vbCrLf
    s = s & "                    .ControlTipText = ""Nesne "" & iSrc(k) & IIf(iKop(k) > 1, "" (kopya "" & iKop(k) & "")"", """") & "": "" & _" & vbCrLf
    s = s & "                                      OlcuYazi(iW(k)) & "" x "" & OlcuYazi(iH(k)) & "" "" & BirimAdi() & _" & vbCrLf
    s = s & "                                      IIf(rR(k), ""  - 90° döndürüldü"", """")" & vbCrLf
    s = s & "                End With" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next k" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    lblPlaka.Caption = ""Plaka "" & gosterPlaka & "" / "" & rSheets" & vbCrLf
    s = s & "    btnOnceki.Enabled = (gosterPlaka > 1)" & vbCrLf
    s = s & "    btnSonraki.Enabled = (gosterPlaka < rSheets)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    lblBilgi.Caption = ""Bu plaka:  "" & adet & "" nesne   •   Kullanım %"" & Format(100 * dolu / (pMatW * pMatH), ""0.0"") & _" & vbCrLf
    s = s & "                       ""   •   Fire %"" & Format(100 - 100 * dolu / (pMatW * pMatH), ""0.0"") & vbCrLf & _" & vbCrLf
    s = s & "                       ""Toplam:  "" & nItem & "" nesne, "" & rSheets & "" plaka ("" & OlcuYazi(pMatW) & "" x "" & _" & vbCrLf
    s = s & "                       OlcuYazi(pMatH) & "" "" & BirimAdi() & "")   •   Ortalama kullanım %"" & _" & vbCrLf
    s = s & "                       Format(100 * topDolu / (rSheets * pMatW * pMatH), ""0.0"")" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "' k. parçanın plaka içi konumu (kenar payı hariç, başlangıç noktasına göre) ve gerçek ölçüsü (mm)" & vbCrLf
    s = s & "Private Sub Konum(ByVal k As Long, ByRef x As Double, ByRef y As Double, ByRef w As Double, ByRef h As Double)" & vbCrLf
    s = s & "    If rR(k) Then" & vbCrLf
    s = s & "        w = iH(k): h = iW(k)" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        w = iW(k): h = iH(k)" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    x = rX(k)" & vbCrLf
    s = s & "    y = rY(k)" & vbCrLf
    s = s & "    Select Case pBasla" & vbCrLf
    s = s & "        Case 1  ' Zemin - orta" & vbCrLf
    s = s & "            x = x + ortaKay(rS(k))" & vbCrLf
    s = s & "        Case 2  ' Zemin - sağ" & vbCrLf
    s = s & "            x = pSW - x - (w + pGap)" & vbCrLf
    s = s & "        Case 3  ' Üst - sol" & vbCrLf
    s = s & "            y = pSH - y - (h + pGap)" & vbCrLf
    s = s & "        Case 4  ' Üst - sağ" & vbCrLf
    s = s & "            x = pSW - x - (w + pGap)" & vbCrLf
    s = s & "            y = pSH - y - (h + pGap)" & vbCrLf
    s = s & "    End Select" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "'=====================================================================" & vbCrLf
    s = s & "'  UYGULA (nesneleri CorelDRAW'da yerleştirir)" & vbCrLf
    s = s & "'=====================================================================" & vbCrLf
    s = s & "Private Function Uygula() As Boolean" & vbCrLf
    s = s & "    Dim doc As Object, sr As Object, eskiBirim As Long, grupAcik As Boolean, msg As String" & vbCrLf
    s = s & "    Dim shp() As Object, sayfalar() As Object, grp() As Object, lyr As Object, frm As Object" & vbCrLf
    s = s & "    Dim k As Long, s As Long, yer As Long, ara As Double" & vbCrLf
    s = s & "    Dim ox As Double, oy As Double, bx As Double, byy As Double, bw As Double, bh As Double" & vbCrLf
    s = s & "    Dim x As Double, y As Double, w As Double, h As Double" & vbCrLf
    s = s & "    Dim dolu() As Double, adetPl() As Long" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    Hesapla" & vbCrLf
    s = s & "    gosterPlaka = 1" & vbCrLf
    s = s & "    Ciz" & vbCrLf
    s = s & "    If Not hesapOK Then" & vbCrLf
    s = s & "        MsgBox hesapMesaj, vbExclamation, ""Otomatik Dizme""" & vbCrLf
    s = s & "        Exit Function" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    Set doc = AktifBelge()" & vbCrLf
    s = s & "    If doc Is Nothing Then" & vbCrLf
    s = s & "        MsgBox ""Seçili nesneler okunamadı. Nesneleri tekrar seçip deneyin."", vbExclamation, ""Otomatik Dizme""" & vbCrLf
    s = s & "        Exit Function" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    yer = cmbPlakaYer.ListIndex" & vbCrLf
    s = s & "    ara = SayiOku(txtPlakaAra.Text) * birimCarpan" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    On Error GoTo Hata" & vbCrLf
    s = s & "    adim = ""hazırlık""" & vbCrLf
    s = s & "    eskiBirim = doc.Unit" & vbCrLf
    s = s & "    doc.Unit = cdrMillimeter" & vbCrLf
    s = s & "    doc.BeginCommandGroup ""Otomatik Dizme""" & vbCrLf
    s = s & "    grupAcik = True" & vbCrLf
    s = s & "    Application.Optimization = True" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' Sayfalar" & vbCrLf
    s = s & "    ReDim sayfalar(1 To rSheets)" & vbCrLf
    s = s & "    Set sayfalar(1) = doc.ActivePage" & vbCrLf
    s = s & "    If chkSayfaBoyut.Value Then sayfalar(1).SetSize pMatW, pMatH" & vbCrLf
    s = s & "    If yer = 2 Then" & vbCrLf
    s = s & "        For s = 2 To rSheets" & vbCrLf
    s = s & "            Set sayfalar(s) = doc.AddPages(1)" & vbCrLf
    s = s & "            sayfalar(s).SetSize sayfalar(1).SizeWidth, sayfalar(1).SizeHeight" & vbCrLf
    s = s & "        Next s" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' Kopyaları oluştur (orijinaller henüz yerindeyken)" & vbCrLf
    s = s & "    adim = ""kopyalar""" & vbCrLf
    s = s & "    ReDim shp(1 To nItem)" & vbCrLf
    s = s & "    For k = 1 To nItem" & vbCrLf
    s = s & "        If iKop(k) = 1 Then" & vbCrLf
    s = s & "            Set shp(k) = secS(iSrc(k))" & vbCrLf
    s = s & "        Else" & vbCrLf
    s = s & "            Set shp(k) = secS(iSrc(k)).Duplicate" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next k" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' Grup listeleri" & vbCrLf
    s = s & "    ReDim grp(1 To rSheets)" & vbCrLf
    s = s & "    For s = 1 To rSheets" & vbCrLf
    s = s & "        Set grp(s) = YeniShapeRange()" & vbCrLf
    s = s & "    Next s" & vbCrLf
    s = s & "    ReDim dolu(1 To rSheets): ReDim adetPl(1 To rSheets)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' Yerleştir" & vbCrLf
    s = s & "    adim = ""yerleştirme""" & vbCrLf
