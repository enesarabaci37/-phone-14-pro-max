    s = s & "" & vbCrLf
    s = s & "'=====================================================================" & vbCrLf
    s = s & "'  DİZME MOTORU (MaxRects, birden çok kural ve sıralama denenir)" & vbCrLf
    s = s & "'=====================================================================" & vbCrLf
    s = s & "Private Function EnIyiYerlesim(ByVal n As Long, aw() As Double, ah() As Double, ByVal SW As Double, ByVal SH As Double, _" & vbCrLf
    s = s & "                               ByVal allowRot As Boolean, ByVal kalite As Long, ByVal arama As Long) As Long" & vbCrLf
    s = s & "    Dim ord() As Long, key() As Double, i As Long, rule As Long, d As Long, s As Long" & vbCrLf
    s = s & "    Dim pS() As Long, pX() As Double, pY() As Double, pR() As Boolean, ext As Double" & vbCrLf
    s = s & "    Dim bestS As Long, bestExt As Double, t0 As Single, rastgele As Single" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ReDim key(1 To n)" & vbCrLf
    s = s & "    bestS = 0" & vbCrLf
    s = s & "    t0 = Timer" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' 1) Genel en iyi seçim (her adımda tüm parçalar arasından en uygunu)" & vbCrLf
    s = s & "    For i = 1 To n" & vbCrLf
    s = s & "        key(i) = Max2(aw(i), ah(i)) * 10000000000# + aw(i) * ah(i)" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    ord = SiraOlustur(key, n)" & vbCrLf
    s = s & "    For rule = 0 To 4" & vbCrLf
    s = s & "        s = PackGlobal(rule, n, aw, ah, ord, SW, SH, allowRot, pS, pX, pY, pR, ext)" & vbCrLf
    s = s & "        EnIyiyiTut s, ext, pS, pX, pY, pR, bestS, bestExt" & vbCrLf
    s = s & "    Next rule" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' 2) Farklı sıralamalarla sıralı yerleştirme" & vbCrLf
    s = s & "    If kalite >= 1 Then" & vbCrLf
    s = s & "        For d = 1 To 5" & vbCrLf
    s = s & "            For i = 1 To n" & vbCrLf
    s = s & "                Select Case d" & vbCrLf
    s = s & "                    Case 1: key(i) = aw(i) * ah(i)" & vbCrLf
    s = s & "                    Case 2: key(i) = Max2(aw(i), ah(i))" & vbCrLf
    s = s & "                    Case 3: key(i) = aw(i)" & vbCrLf
    s = s & "                    Case 4: key(i) = ah(i)" & vbCrLf
    s = s & "                    Case Else: key(i) = aw(i) + ah(i)" & vbCrLf
    s = s & "                End Select" & vbCrLf
    s = s & "            Next i" & vbCrLf
    s = s & "            ord = SiraOlustur(key, n)" & vbCrLf
    s = s & "            For rule = 0 To 4" & vbCrLf
    s = s & "                s = PackSeq(rule, n, aw, ah, ord, SW, SH, allowRot, pS, pX, pY, pR, ext)" & vbCrLf
    s = s & "                EnIyiyiTut s, ext, pS, pX, pY, pR, bestS, bestExt" & vbCrLf
    s = s & "            Next rule" & vbCrLf
    s = s & "            DoEvents" & vbCrLf
    s = s & "        Next d" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' 3) Karışık sıralamalarla ek arama" & vbCrLf
    s = s & "    If kalite >= 2 Then" & vbCrLf
    s = s & "        rastgele = Rnd(-1)" & vbCrLf
    s = s & "        Randomize 7" & vbCrLf
    s = s & "        For d = 1 To arama" & vbCrLf
    s = s & "            For i = 1 To n" & vbCrLf
    s = s & "                key(i) = aw(i) * ah(i) * (0.6 + 0.8 * Rnd)" & vbCrLf
    s = s & "            Next i" & vbCrLf
    s = s & "            ord = SiraOlustur(key, n)" & vbCrLf
    s = s & "            For rule = 0 To 4" & vbCrLf
    s = s & "                s = PackSeq(rule, n, aw, ah, ord, SW, SH, allowRot, pS, pX, pY, pR, ext)" & vbCrLf
    s = s & "                EnIyiyiTut s, ext, pS, pX, pY, pR, bestS, bestExt" & vbCrLf
    s = s & "            Next rule" & vbCrLf
    s = s & "            lblBilgi.Caption = ""En iyi sonuç aranıyor... "" & d & "" / "" & arama" & vbCrLf
    s = s & "            DoEvents" & vbCrLf
    s = s & "            If Abs(Timer - t0) > 30 Then Exit For" & vbCrLf
    s = s & "        Next d" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    EnIyiYerlesim = bestS" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub EnIyiyiTut(ByVal s As Long, ByVal ext As Double, pS() As Long, pX() As Double, pY() As Double, pR() As Boolean, _" & vbCrLf
    K_frmDizme_2 = s
End Function

Private Function K_frmDizme_3() As String
    Dim s As String
    s = s & "                       ByRef bestS As Long, ByRef bestExt As Double)" & vbCrLf
    s = s & "    If s <= 0 Then Exit Sub" & vbCrLf
    s = s & "    If bestS = 0 Or s < bestS Or (s = bestS And ext < bestExt - EPS) Then" & vbCrLf
    s = s & "        bestS = s" & vbCrLf
    s = s & "        bestExt = ext" & vbCrLf
    s = s & "        rS = pS: rX = pX: rY = pY: rR = pR" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "' Anahtara göre büyükten küçüğe sıra (kararlı ekleme sıralaması)" & vbCrLf
    s = s & "Private Function SiraOlustur(key() As Double, ByVal n As Long) As Long()" & vbCrLf
    s = s & "    Dim o() As Long, i As Long, j As Long, t As Long" & vbCrLf
    s = s & "    ReDim o(1 To n)" & vbCrLf
    s = s & "    For i = 1 To n: o(i) = i: Next i" & vbCrLf
    s = s & "    For i = 2 To n" & vbCrLf
    s = s & "        t = o(i)" & vbCrLf
    s = s & "        j = i - 1" & vbCrLf
    s = s & "        Do While j >= 1" & vbCrLf
    s = s & "            If key(t) > key(o(j)) + EPS Then" & vbCrLf
    s = s & "                o(j + 1) = o(j)" & vbCrLf
    s = s & "                j = j - 1" & vbCrLf
    s = s & "            Else" & vbCrLf
    s = s & "                Exit Do" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        Loop" & vbCrLf
    s = s & "        o(j + 1) = t" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    SiraOlustur = o" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function PackGlobal(ByVal rule As Long, ByVal n As Long, aw() As Double, ah() As Double, ord() As Long, _" & vbCrLf
    s = s & "                            ByVal SW As Double, ByVal SH As Double, ByVal allowRot As Boolean, _" & vbCrLf
    s = s & "                            pS() As Long, pX() As Double, pY() As Double, pR() As Boolean, ByRef ext As Double) As Long" & vbCrLf
    s = s & "    Dim placed() As Boolean, kalan As Long, plaka As Long, plakadaki As Long" & vbCrLf
    s = s & "    Dim k As Long, i As Long, bi As Long, lw As Double, lh As Double" & vbCrLf
    s = s & "    Dim x As Double, y As Double, rt As Boolean, s1 As Double, s2 As Double" & vbCrLf
    s = s & "    Dim gx As Double, gy As Double, gr As Boolean, g1 As Double, g2 As Double" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ReDim placed(1 To n): ReDim pS(1 To n): ReDim pX(1 To n): ReDim pY(1 To n): ReDim pR(1 To n)" & vbCrLf
    s = s & "    kalan = n: plaka = 1: plakadaki = 0" & vbCrLf
    s = s & "    FreeInit SW, SH" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    Do While kalan > 0" & vbCrLf
    s = s & "        bi = 0: g1 = 1E+300: g2 = 1E+300" & vbCrLf
    s = s & "        lw = -1: lh = -1" & vbCrLf
    s = s & "        For k = 1 To n" & vbCrLf
    s = s & "            i = ord(k)" & vbCrLf
    s = s & "            If Not placed(i) Then" & vbCrLf
    s = s & "                If Not (Abs(aw(i) - lw) < EPS And Abs(ah(i) - lh) < EPS) Then" & vbCrLf
    s = s & "                    lw = aw(i): lh = ah(i)" & vbCrLf
    s = s & "                    If EnIyiYer(rule, aw(i), ah(i), allowRot, x, y, rt, s1, s2) Then" & vbCrLf
    s = s & "                        If s1 < g1 - EPS Or (Abs(s1 - g1) <= EPS And s2 < g2 - EPS) Then" & vbCrLf
    s = s & "                            bi = i: g1 = s1: g2 = s2: gx = x: gy = y: gr = rt" & vbCrLf
    s = s & "                        End If" & vbCrLf
    s = s & "                    End If" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        Next k" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        If bi = 0 Then" & vbCrLf
    s = s & "            If plakadaki = 0 Then PackGlobal = -1: Exit Function" & vbCrLf
    s = s & "            plaka = plaka + 1" & vbCrLf
    s = s & "            plakadaki = 0" & vbCrLf
    s = s & "            FreeInit SW, SH" & vbCrLf
    s = s & "        Else" & vbCrLf
    s = s & "            Yerlestir bi, plaka, gx, gy, gr, aw, ah, placed, pS, pX, pY, pR" & vbCrLf
    s = s & "            kalan = kalan - 1" & vbCrLf
    s = s & "            plakadaki = plakadaki + 1" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ext = SonPlakaAlani(n, plaka, aw, ah, pS, pX, pY, pR)" & vbCrLf
    s = s & "    PackGlobal = plaka" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function PackSeq(ByVal rule As Long, ByVal n As Long, aw() As Double, ah() As Double, ord() As Long, _" & vbCrLf
    s = s & "                         ByVal SW As Double, ByVal SH As Double, ByVal allowRot As Boolean, _" & vbCrLf
    s = s & "                         pS() As Long, pX() As Double, pY() As Double, pR() As Boolean, ByRef ext As Double) As Long" & vbCrLf
    s = s & "    Dim placed() As Boolean, kalan As Long, plaka As Long, plakadaki As Long" & vbCrLf
    s = s & "    Dim k As Long, i As Long, x As Double, y As Double, rt As Boolean, s1 As Double, s2 As Double" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ReDim placed(1 To n): ReDim pS(1 To n): ReDim pX(1 To n): ReDim pY(1 To n): ReDim pR(1 To n)" & vbCrLf
    s = s & "    kalan = n: plaka = 0" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    Do While kalan > 0" & vbCrLf
    s = s & "        plaka = plaka + 1" & vbCrLf
    s = s & "        plakadaki = 0" & vbCrLf
    s = s & "        FreeInit SW, SH" & vbCrLf
    s = s & "        For k = 1 To n" & vbCrLf
    s = s & "            i = ord(k)" & vbCrLf
    s = s & "            If Not placed(i) Then" & vbCrLf
    s = s & "                If EnIyiYer(rule, aw(i), ah(i), allowRot, x, y, rt, s1, s2) Then" & vbCrLf
    s = s & "                    Yerlestir i, plaka, x, y, rt, aw, ah, placed, pS, pX, pY, pR" & vbCrLf
    s = s & "                    kalan = kalan - 1" & vbCrLf
    s = s & "                    plakadaki = plakadaki + 1" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        Next k" & vbCrLf
    s = s & "        If plakadaki = 0 Then PackSeq = -1: Exit Function" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ext = SonPlakaAlani(n, plaka, aw, ah, pS, pX, pY, pR)" & vbCrLf
    s = s & "    PackSeq = plaka" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub Yerlestir(ByVal i As Long, ByVal plaka As Long, ByVal x As Double, ByVal y As Double, ByVal rt As Boolean, _" & vbCrLf
    s = s & "                      aw() As Double, ah() As Double, placed() As Boolean, _" & vbCrLf
    s = s & "                      pS() As Long, pX() As Double, pY() As Double, pR() As Boolean)" & vbCrLf
    s = s & "    placed(i) = True" & vbCrLf
    s = s & "    pS(i) = plaka: pX(i) = x: pY(i) = y: pR(i) = rt" & vbCrLf
    s = s & "    If rt Then" & vbCrLf
    s = s & "        PlaceRect x, y, ah(i), aw(i)" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        PlaceRect x, y, aw(i), ah(i)" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "' Bir parça için mevcut boş alanlar arasında en iyi yer" & vbCrLf
    s = s & "Private Function EnIyiYer(ByVal rule As Long, ByVal w0 As Double, ByVal h0 As Double, ByVal allowRot As Boolean, _" & vbCrLf
    s = s & "                          ByRef bxp As Double, ByRef byp As Double, ByRef bRot As Boolean, _" & vbCrLf
    s = s & "                          ByRef b1 As Double, ByRef b2 As Double) As Boolean" & vbCrLf
    s = s & "    Dim o As Long, r As Long, w As Double, h As Double, s1 As Double, s2 As Double" & vbCrLf
    s = s & "    b1 = 1E+300: b2 = 1E+300" & vbCrLf
    s = s & "    For o = 0 To 1" & vbCrLf
    s = s & "        If o = 0 Then" & vbCrLf
    s = s & "            w = w0: h = h0" & vbCrLf
    s = s & "        Else" & vbCrLf
    s = s & "            w = h0: h = w0" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "        If o = 0 Or (allowRot And Abs(w - h) > EPS) Then" & vbCrLf
    s = s & "            For r = 1 To fc" & vbCrLf
    s = s & "                If w <= fw(r) + EPS And h <= fh(r) + EPS Then" & vbCrLf
    s = s & "                    Puan rule, r, w, h, s1, s2" & vbCrLf
    s = s & "                    If s1 < b1 - EPS Or (Abs(s1 - b1) <= EPS And s2 < b2 - EPS) Then" & vbCrLf
    s = s & "                        b1 = s1: b2 = s2" & vbCrLf
    s = s & "                        bxp = fx(r): byp = fy(r): bRot = (o = 1)" & vbCrLf
    s = s & "                        EnIyiYer = True" & vbCrLf
    s = s & "                    End If" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "            Next r" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next o" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub Puan(ByVal rule As Long, ByVal r As Long, ByVal w As Double, ByVal h As Double, _" & vbCrLf
    s = s & "                 ByRef s1 As Double, ByRef s2 As Double)" & vbCrLf
    s = s & "    Dim lw As Double, lh As Double" & vbCrLf
    s = s & "    lw = fw(r) - w" & vbCrLf
    s = s & "    lh = fh(r) - h" & vbCrLf
    s = s & "    Select Case rule" & vbCrLf
    s = s & "        Case 0      ' En iyi kısa kenar uyumu" & vbCrLf
    s = s & "            s1 = Min2(lw, lh): s2 = Max2(lw, lh)" & vbCrLf
    s = s & "        Case 1      ' En iyi uzun kenar uyumu" & vbCrLf
    s = s & "            s1 = Max2(lw, lh): s2 = Min2(lw, lh)" & vbCrLf
    s = s & "        Case 2      ' En iyi alan uyumu" & vbCrLf
    s = s & "            s1 = fw(r) * fh(r) - w * h: s2 = Min2(lw, lh)" & vbCrLf
    s = s & "        Case 3      ' Satır satır (alttan)" & vbCrLf
    s = s & "            s1 = fy(r) + h: s2 = fx(r)" & vbCrLf
    s = s & "        Case Else   ' Sütun sütun (soldan)" & vbCrLf
    s = s & "            s1 = fx(r) + w: s2 = fy(r)" & vbCrLf
    s = s & "    End Select" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function SonPlakaAlani(ByVal n As Long, ByVal plaka As Long, aw() As Double, ah() As Double, _" & vbCrLf
    s = s & "                               pS() As Long, pX() As Double, pY() As Double, pR() As Boolean) As Double" & vbCrLf
    s = s & "    Dim i As Long, w As Double, h As Double, mx As Double, my As Double" & vbCrLf
    s = s & "    For i = 1 To n" & vbCrLf
    s = s & "        If pS(i) = plaka Then" & vbCrLf
    s = s & "            If pR(i) Then" & vbCrLf
    s = s & "                w = ah(i): h = aw(i)" & vbCrLf
    s = s & "            Else" & vbCrLf
    s = s & "                w = aw(i): h = ah(i)" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "            If pX(i) + w > mx Then mx = pX(i) + w" & vbCrLf
    s = s & "            If pY(i) + h > my Then my = pY(i) + h" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    SonPlakaAlani = mx * my" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub FreeInit(ByVal W As Double, ByVal H As Double)" & vbCrLf
    s = s & "    ReDim fx(1 To 1): ReDim fy(1 To 1): ReDim fw(1 To 1): ReDim fh(1 To 1)" & vbCrLf
    s = s & "    fx(1) = 0: fy(1) = 0: fw(1) = W: fh(1) = H" & vbCrLf
    s = s & "    fc = 1" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub TAdd(ByVal x As Double, ByVal y As Double, ByVal w As Double, ByVal h As Double)" & vbCrLf
    s = s & "    If w <= EPS Or h <= EPS Then Exit Sub" & vbCrLf
    s = s & "    tc = tc + 1" & vbCrLf
    s = s & "    tx(tc) = x: ty(tc) = y: tw(tc) = w: th(tc) = h" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function TIn(ByVal i As Long, ByVal j As Long) As Boolean" & vbCrLf
    s = s & "    TIn = (tx(i) >= tx(j) - EPS And ty(i) >= ty(j) - EPS And _" & vbCrLf
    s = s & "           tx(i) + tw(i) <= tx(j) + tw(j) + EPS And ty(i) + th(i) <= ty(j) + th(j) + EPS)" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub PlaceRect(ByVal x As Double, ByVal y As Double, ByVal w As Double, ByVal h As Double)" & vbCrLf
    s = s & "    Dim i As Long, j As Long, cnt As Long, keep() As Boolean" & vbCrLf
    s = s & "    Dim ax As Double, ay As Double, aww As Double, ahh As Double" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    tc = 0" & vbCrLf
    s = s & "    ReDim tx(1 To fc * 4 + 4): ReDim ty(1 To fc * 4 + 4)" & vbCrLf
    s = s & "    ReDim tw(1 To fc * 4 + 4): ReDim th(1 To fc * 4 + 4)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    For i = 1 To fc" & vbCrLf
    s = s & "        ax = fx(i): ay = fy(i): aww = fw(i): ahh = fh(i)" & vbCrLf
    s = s & "        If x >= ax + aww - EPS Or x + w <= ax + EPS Or y >= ay + ahh - EPS Or y + h <= ay + EPS Then" & vbCrLf
    s = s & "            TAdd ax, ay, aww, ahh" & vbCrLf
    s = s & "        Else" & vbCrLf
    s = s & "            If x > ax + EPS Then TAdd ax, ay, x - ax, ahh" & vbCrLf
    s = s & "            If x + w < ax + aww - EPS Then TAdd x + w, ay, ax + aww - x - w, ahh" & vbCrLf
    s = s & "            If y > ay + EPS Then TAdd ax, ay, aww, y - ay" & vbCrLf
    s = s & "            If y + h < ay + ahh - EPS Then TAdd ax, y + h, aww, ay + ahh - y - h" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    If tc = 0 Then fc = 0: Exit Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ReDim keep(1 To tc)" & vbCrLf
    s = s & "    For i = 1 To tc: keep(i) = True: Next i" & vbCrLf
    s = s & "    For i = 1 To tc" & vbCrLf
    s = s & "        For j = 1 To tc" & vbCrLf
    s = s & "            If i <> j And keep(j) Then" & vbCrLf
    s = s & "                If TIn(i, j) Then" & vbCrLf
    s = s & "                    If (Not TIn(j, i)) Or j < i Then keep(i) = False: Exit For" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        Next j" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ReDim fx(1 To tc): ReDim fy(1 To tc): ReDim fw(1 To tc): ReDim fh(1 To tc)" & vbCrLf
    s = s & "    cnt = 0" & vbCrLf
    s = s & "    For i = 1 To tc" & vbCrLf
    s = s & "        If keep(i) Then" & vbCrLf
    s = s & "            cnt = cnt + 1" & vbCrLf
    s = s & "            fx(cnt) = tx(i): fy(cnt) = ty(i): fw(cnt) = tw(i): fh(cnt) = th(i)" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    fc = cnt" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function Min2(ByVal a As Double, ByVal b As Double) As Double" & vbCrLf
    s = s & "    If a < b Then Min2 = a Else Min2 = b" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function Max2(ByVal a As Double, ByVal b As Double) As Double" & vbCrLf
    s = s & "    If a > b Then Max2 = a Else Max2 = b" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    K_frmDizme_3 = s
End Function

Private Function K_baslangic_1() As String
    Dim s As String
    s = s & "" & vbCrLf
    s = s & "' Atölye Araçları: CorelDRAW her açıldığında araç çubuğunu kontrol eder," & vbCrLf
    s = s & "' yoksa kendiliğinden yeniden kurar." & vbCrLf
    s = s & "Private Sub GlobalMacroStorage_Start()" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    modAtolye.AracCubuguOtomatik" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    K_baslangic_1 = s
End Function
