    s = s & "    tb.Text = Frm.SayiYaz(v)" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub tb_Change()" & vbCrLf
    s = s & "    Frm.AyarDegisti" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub cb_Change()" & vbCrLf
    s = s & "    Frm.AyarDegisti" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub ch_Click()" & vbCrLf
    s = s & "    Frm.AyarDegisti" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    K_clsOlay_1 = s
End Function

Private Function K_modAtolye_1() As String
    Dim s As String
    s = s & "Option Explicit" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "'=====================================================================" & vbCrLf
    s = s & "'  ATÖLYE ARAÇLARI - Başlatıcı ve araç çubuğu kurulumu" & vbCrLf
    s = s & "'  - Dizme          : Otomatik Dizme penceresini açar" & vbCrLf
    s = s & "'  - AracCubuguKur  : CorelDRAW üst barına ""Atölye Araçları"" çubuğunu ekler" & vbCrLf
    s = s & "'  İleride eklenecek yeni araçlar da bu çubuğa düğme olarak eklenir." & vbCrLf
    s = s & "'=====================================================================" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Const CUBUK_ADI As String = ""Atölye Araçları""" & vbCrLf
    s = s & "Private Const MAKRO_KATEGORI As String = ""2cc24a3e-fe24-4708-9a74-9c75406eebcd""" & vbCrLf
    s = s & "Private Const PROJE As String = ""GlobalMacros""" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "' ---- Araçlar ----" & vbCrLf
    s = s & "Public Sub Dizme()" & vbCrLf
    s = s & "    frmDizme.Show vbModeless" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "' ---- Araç çubuğunu kur / yenile (elle çalıştırmak için) ----" & vbCrLf
    s = s & "Public Sub AracCubuguKur()" & vbCrLf
    s = s & "    CubukKur False" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "' ---- CorelDRAW açılırken otomatik çağrılır (ThisMacroStorage) ----" & vbCrLf
    s = s & "Public Sub AracCubuguOtomatik()" & vbCrLf
    s = s & "    Dim cbs As Object, cb As Object" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    Set cbs = CubukListesi()" & vbCrLf
    s = s & "    If cbs Is Nothing Then Exit Sub" & vbCrLf
    s = s & "    Set cb = cbs.Item(CUBUK_ADI)" & vbCrLf
    s = s & "    If cb Is Nothing Then" & vbCrLf
    s = s & "        CubukKur True" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        If cb.Controls.Count = 0 Then" & vbCrLf
    s = s & "            CubukKur True" & vbCrLf
    s = s & "        Else" & vbCrLf
    s = s & "            cb.Visible = True" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub CubukKur(ByVal sessiz As Boolean)" & vbCrLf
    s = s & "    Dim cbs As Object, cb As Object, sonuc As String" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    Set cbs = CubukListesi()" & vbCrLf
    s = s & "    If cbs Is Nothing Then" & vbCrLf
    s = s & "        If Not sessiz Then ElleKurulumMesaji ""Araç çubukları listesine erişilemedi.""" & vbCrLf
    s = s & "        Exit Sub" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' Eskisi varsa kaldır" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    cbs.Item(CUBUK_ADI).Delete" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "    Set cb = cbs.Add(CUBUK_ADI, 1, False)   ' 1 = üst bara yerleş" & vbCrLf
    s = s & "    On Error GoTo 0" & vbCrLf
    s = s & "    If cb Is Nothing Then" & vbCrLf
    s = s & "        If Not sessiz Then ElleKurulumMesaji ""Yeni araç çubuğu oluşturulamadı.""" & vbCrLf
    s = s & "        Exit Sub" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    sonuc = DugmeEkle(cb, ""Dizme"", ""Otomatik Dizme"", _" & vbCrLf
    s = s & "                      ""Otomatik Dizme (Nesting): seçili nesneleri malzemeye en az fire ile dizer"", IkonYaz(""dizme.ico"", IkonDizme()))" & vbCrLf
