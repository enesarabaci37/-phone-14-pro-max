Attribute VB_Name = "modAtolye"
Option Explicit

'=====================================================================
'  ATÖLYE ARAÇLARI - Baþlatýcý ve araç çubuðu kurulumu
'  - Dizme          : Otomatik Dizme penceresini açar
'  - AracCubuguKur  : CorelDRAW üst barýna "Atölye Araçlarý" çubuðunu ekler
'  Ýleride eklenecek yeni araçlar da bu çubuða düðme olarak eklenir.
'=====================================================================

Private Const CUBUK_ADI As String = "Atölye Araçlarý"
Private Const MAKRO_KATEGORI As String = "2cc24a3e-fe24-4708-9a74-9c75406eebcd"
Private Const PROJE As String = "GlobalMacros"

' ---- Araçlar ----
Public Sub Dizme()
    frmDizme.Show vbModeless
End Sub

' ---- Araç çubuðunu kur (bir kez çalýþtýrmanýz yeterli) ----
Public Sub AracCubuguKur()
    Dim cbs As Object, cb As Object, sonuc As String

    Set cbs = CubukListesi()
    If cbs Is Nothing Then
        ElleKurulumMesaji "Araç çubuklarý listesine eriþilemedi."
        Exit Sub
    End If

    ' Eskisi varsa kaldýr
    On Error Resume Next
    cbs.Item(CUBUK_ADI).Delete
    Err.Clear
    Set cb = cbs.Add(CUBUK_ADI, 1, False)   ' 1 = üst bara yerleþ
    On Error GoTo 0
    If cb Is Nothing Then
        ElleKurulumMesaji "Yeni araç çubuðu oluþturulamadý."
        Exit Sub
    End If

    sonuc = DugmeEkle(cb, "Dizme", "Otomatik Dizme", _
                      "Otomatik Dizme (Nesting): seçili nesneleri malzemeye en az fire ile dizer", IkonYaz("dizme.ico", IkonDizme()))

    On Error Resume Next
    cb.Visible = True
    On Error GoTo 0

    If sonuc = "" Then
        MsgBox "'" & CUBUK_ADI & "' araç çubuðu eklendi." & vbCrLf & vbCrLf & _
               "Görmüyorsanýz: Pencere > Araç Çubuklarý > " & CUBUK_ADI & vbCrLf & _
               "Çubuðu fareyle tutup üst bardaki istediðiniz yere sürükleyebilirsiniz.", _
               vbInformation, "Atölye Araçlarý"
    Else
        MsgBox "Araç çubuðu eklendi fakat bir uyarý var:" & vbCrLf & sonuc, vbExclamation, "Atölye Araçlarý"
    End If
End Sub

Private Function CubukListesi() As Object
    Dim app As Object
    Set app = Application
    On Error Resume Next
    Set CubukListesi = app.CommandBars
    If CubukListesi Is Nothing Then Set CubukListesi = app.FrameWork.CommandBars
End Function

Private Function DugmeEkle(cb As Object, ByVal makro As String, ByVal baslik As String, _
                           ByVal ipucu As String, ByVal ikonYolu As String) As String
    Dim ctl As Object, simgeTamam As Boolean
    On Error Resume Next
    Set ctl = cb.Controls.AddCustomButton(MAKRO_KATEGORI, PROJE & ".modAtolye." & makro)
    If ctl Is Nothing Then
        DugmeEkle = "Düðme eklenemedi. Düðmeyi elle ekleyin (KURULUM.txt, Adým 4)."
        Exit Function
    End If
    ctl.Caption = baslik
    ctl.ToolTipText = ipucu
    ctl.Description = ipucu
    If ikonYolu <> "" Then
        Err.Clear
        ctl.SetCustomIcon ikonYolu
        simgeTamam = (Err.Number = 0)
        If Not simgeTamam Then
            Err.Clear
            ctl.SetIcon2 ikonYolu
            simgeTamam = (Err.Number = 0)
        End If
    End If
    If Not simgeTamam Then DugmeEkle = "Simge yüklenemedi; düðme yazý ile görünecek."
End Function

Private Sub ElleKurulumMesaji(ByVal neden As String)
    MsgBox neden & vbCrLf & vbCrLf & _
           "Düðmeyi elle ekleyebilirsiniz:" & vbCrLf & _
           "Araçlar > Seçenekler > Özelleþtirme > Komutlar" & vbCrLf & _
           "Açýlýr listeden 'Makrolar' seçin, 'modAtolye.Dizme' öðesini" & vbCrLf & _
           "üst bardaki bir araç çubuðuna sürükleyip býrakýn.", vbExclamation, "Atölye Araçlarý"
End Sub

' Simge dosyasýný %APPDATA%\AtolyeAraclari klasörüne yazar
Private Function IkonYaz(ByVal dosyaAdi As String, ByVal hx As String) As String
    Dim klasor As String, yol As String, b() As Byte, i As Long, f As Integer
    On Error GoTo Hata
    klasor = Environ$("APPDATA") & "\AtolyeAraclari"
    If Dir$(klasor, vbDirectory) = "" Then MkDir klasor
    yol = klasor & "\" & dosyaAdi
    If Dir$(yol) <> "" Then Kill yol
    ReDim b(0 To Len(hx) \ 2 - 1)
    For i = 0 To UBound(b)
        b(i) = CByte("&H" & Mid$(hx, i * 2 + 1, 2))
    Next i
    f = FreeFile
    Open yol For Binary Access Write As #f
    Put #f, , b
    Close #f
    IkonYaz = yol
    Exit Function
Hata:
    IkonYaz = ""
End Function

